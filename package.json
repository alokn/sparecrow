{
  "name": "sparecrow",
  "version": "1.0.0-beta.1",
  "description": "sparecrow — CLI tool + background daemon that monitors Claude Code subscription usage and dispatches queued tasks automatically",
  "type": "module",
  "bin": {
    "sparecrow": "./dist/index.js",
    "scrow": "./dist/index.js"
  },
  "man": "./dist/sparecrow.1",
  "files": [
    "dist/",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "oxlint src/ tests/e2e/",
    "format": "prettier --write src/ tests/e2e/ vitest.e2e.config.ts",
    "format:check": "prettier --check src/ tests/e2e/ vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit --project tsconfig.e2e.json",
    "docs": "typedoc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alokn/sparecrow.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "usage-monitor",
    "cli",
    "automation",
    "sparecrow"
  ],
  "author": "Alok",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alokn/sparecrow/issues"
  },
  "homepage": "https://github.com/alokn/sparecrow#readme",
  "devDependencies": {
    "@j178/prek": "^0.4.0",
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "marked-man": "^2.1.0",
    "node-pty": "^1.2.0-beta.12",
    "oxlint": "^1.50.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.17",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "env-paths": "^4.0.0",
    "ora": "^9.3.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@j178/prek": {
      "axios": ">=1.13.5",
      "minimatch": ">=10.2.3",
      "@isaacs/brace-expansion": ">=5.0.1"
    }
  }
}
